{
  "name": "@tiryoh/shxray",
  "version": "0.1.0",
  "license": "MIT",
  "exports": {
    ".": "./src/main.ts",
    "./analyze": "./src/analyze/mod.ts"
  },
  "tasks": {
    "check": "deno check src/main.ts tests/unit/analyze_test.ts tests/unit/render_test.ts tests/unit/architecture_test.ts tests/e2e/cli_test.ts tests/e2e/compile_test.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "test": "deno test --allow-read --allow-run --allow-write",
    "test:unit": "deno test --allow-read tests/unit",
    "test:e2e": "deno test --allow-read --allow-run --allow-write tests/e2e",
    "compile": "deno compile --allow-read --allow-env --output dist/shxray src/main.ts",
    "compile:smoke": "deno task compile && ./dist/shxray --json tests/fixtures/installer.sh"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "sh-syntax": "npm:sh-syntax@0.8.7"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "include": ["src/", "tests/", "deno.json"]
  }
}
